---
import Base from "~/layouts/Base.astro";
import PageHeader from "~/components/PageHeader.astro";
import VideoGrid from "~/components/VideoGrid.astro";
import { getCategories, getVideos } from "~/lib/data";
import { href } from "~/lib/format";

export function getStaticPaths() {
  return getCategories().map((c) => ({ params: { category: c.slug }, props: { category: c } }));
}
const { category: c } = Astro.props;
const videos = getVideos();
const PREVIEW = 8;
const sections = c.subtopics
  .map((s) => ({ s, vids: videos.filter((v) => v.topics.includes(s.key)) }))
  .filter((x) => x.vids.length > 0);
---
<Base title={c.name} description={c.description}>
  <PageHeader title={c.name} eyebrow="Topic" crumbs={[{ label: "Topics", href: href("/topics/") }]}>
    <p class="mt-3 max-w-2xl text-muted">{c.description}</p>
    <ul class="mt-5 flex flex-wrap gap-2">
      {sections.map(({ s, vids }) => <li><a href={`#${s.slug}`} class="inline-block rounded-full bg-surface border border-line px-3 py-1 text-sm hover:text-accent">{s.name} <span class="text-muted">{vids.length}</span></a></li>)}
    </ul>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 mt-10 space-y-14">
    {sections.map(({ s, vids }) => (
      <section id={s.slug} aria-labelledby={`h-${s.slug}`} class="scroll-mt-20">
        <div class="mb-4 flex items-baseline justify-between gap-4">
          <div>
            <h2 id={`h-${s.slug}`} class="font-serif text-2xl font-semibold">{s.name}</h2>
            <p class="text-sm text-muted">{s.description}</p>
          </div>
          {vids.length > PREVIEW && <a href={href(`/topics/${s.key}/`)} class="shrink-0 text-sm text-accent hover:underline">All {vids.length} →</a>}
        </div>
        <VideoGrid videos={vids.slice(0, PREVIEW)} />
      </section>
    ))}
  </div>
</Base>
