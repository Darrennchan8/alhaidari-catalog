---
import Base from "~/layouts/Base.astro";
import PageHeader from "~/components/PageHeader.astro";
import VideoList from "~/components/VideoList.astro";
import { getCategories, getVideos } from "~/lib/data";
import { href } from "~/lib/format";

export function getStaticPaths() {
  return getCategories().flatMap((c) =>
    c.subtopics.map((s) => ({ params: { category: c.slug, sub: s.slug }, props: { category: c, sub: s } })),
  );
}
const { category: c, sub: s } = Astro.props;
// Primary-topic matches first, then by transcript availability and date.
const videos = getVideos()
  .filter((v) => v.topics.includes(s.key))
  .sort((a, b) =>
    Number(b.topics[0] === s.key) - Number(a.topics[0] === s.key) ||
    Number(b.has_transcript) - Number(a.has_transcript) ||
    (b.upload_date ?? "").localeCompare(a.upload_date ?? ""),
  );
---
<Base title={`${s.name} — ${c.name}`} description={s.description}>
  <PageHeader title={s.name} eyebrow={c.name} crumbs={[{ label: "Topics", href: href("/topics/") }, { label: c.name, href: href(`/topics/${c.slug}/`) }]}>
    <p class="mt-3 max-w-2xl text-muted">{s.description}</p>
    <p class="mt-2 text-sm text-muted">{videos.length} videos</p>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 mt-8">
    <VideoList videos={videos} />
  </div>
</Base>
