---
import Base from "~/layouts/Base.astro";
import PageHeader from "~/components/PageHeader.astro";
import { getCategories, getStats } from "~/lib/data";
import { href } from "~/lib/format";

const categories = getCategories().filter((c) => c.count > 0);
const stats = getStats();
---
<Base title="Topics" description="Browse al-Haydari's lectures by subject: philosophy, theology, jurisprudence, Qur'anic exegesis, hadith studies and more.">
  <PageHeader title="Topics" eyebrow="Browse by subject">
    <p class="mt-3 max-w-2xl text-muted">
      Every video is assigned to one or more subjects, independently of the channel's playlists.
      {stats.with_topics < stats.videos && ` ${stats.with_topics.toLocaleString("en")} of ${stats.videos.toLocaleString("en")} videos are classified so far.`}
    </p>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 mt-10 grid gap-6 md:grid-cols-2">
    {categories.length === 0 && <p class="text-muted">The topic taxonomy hasn't been generated yet. Run <code>catalog taxonomy</code>.</p>}
    {categories.map((c) => (
      <section class="rounded-xl border border-line bg-surface p-5" aria-labelledby={`c-${c.slug}`}>
        <h2 id={`c-${c.slug}`} class="font-serif text-xl font-semibold">
          <a href={href(`/topics/${c.slug}/`)} class="hover:text-accent">{c.name}</a>
          <span class="ml-2 text-sm font-sans font-normal text-muted">{c.count}</span>
        </h2>
        <p class="mt-1 text-sm text-muted">{c.description}</p>
        <ul class="mt-4 flex flex-wrap gap-2">
          {c.subtopics.filter((s) => s.count > 0).map((s) => (
            <li><a href={href(`/topics/${s.key}/`)} class="inline-block rounded-full border border-line px-3 py-1 text-sm hover:border-accent hover:text-accent">{s.name} <span class="text-muted">{s.count}</span></a></li>
          ))}
        </ul>
      </section>
    ))}
  </div>
</Base>
