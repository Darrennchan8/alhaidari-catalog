---
import Base from "~/layouts/Base.astro";
import Player from "~/components/Player.astro";
import Transcript from "~/components/Transcript.astro";
import TopicChips from "~/components/TopicChips.astro";
import { getPlaylists, getVideo, getVideos, playlistVideos, topicInfo } from "~/lib/data";
import { compact, date, duration, href, langAttrs, thumb, timestamp, title } from "~/lib/format";
import { quranLabel, quranUrl } from "~/lib/quran";

export function getStaticPaths() {
  return getVideos().map((v) => ({ params: { id: v.id } }));
}

const { id } = Astro.params;
const v = getVideo(id!);
const playlists = getPlaylists().filter((p) => v.playlists.includes(p.slug));
const primary = playlists[0];
let prev, next;
if (primary) {
  const list = playlistVideos(primary);
  const i = list.findIndex((x) => x.id === v.id);
  prev = list[i - 1];
  next = list[i + 1];
}
const refs = v.references;
const t = title(v);
const hasRefs = refs.quran.length + refs.people.length + refs.works.length > 0;
const description = v.summary || `English catalog entry for “${v.title_en || v.title_ar}” by Sayyid Kamal al-Haydari.`;
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "VideoObject",
  name: v.title_en || v.title_ar,
  alternateName: v.title_ar,
  description,
  thumbnailUrl: thumb(v.id, "hq"),
  uploadDate: v.upload_date ?? undefined,
  duration: v.duration ? `PT${v.duration}S` : undefined,
  embedUrl: `https://www.youtube.com/embed/${v.id}`,
  inLanguage: "ar",
  transcript: v.segments.length ? v.segments.map((s) => s.text).join(" ").slice(0, 5000) : undefined,
};
const categoryNames = [...new Set(v.topics.map((t) => topicInfo(t)?.category.name).filter(Boolean))];
---
<Base title={t.text} description={description.slice(0, 300)} image={thumb(v.id, "hq")} jsonLd={jsonLd}>
  <article class="mx-auto max-w-6xl px-4 py-6 sm:py-8" data-pagefind-body>
    <div class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem]">
      <div class="min-w-0 space-y-6">
        <Player id={v.id} title={t.text} />

        <header class="space-y-2">
          {primary && (
            <p class="text-sm font-medium text-gold" data-pagefind-filter="series">
              <a class="hover:underline" href={href(`/series/${primary.slug}/`)} {...langAttrs(title(primary).ar)}>{title(primary).text}</a>
            </p>
          )}
          <h1 class="font-serif text-2xl sm:text-3xl font-semibold leading-tight text-balance" data-pagefind-meta="title" {...langAttrs(t.ar)}>{t.text}</h1>
          {!t.ar && <p lang="ar" dir="rtl" class="text-lg text-muted">{v.title_ar}</p>}
          <p class="flex flex-wrap gap-x-3 gap-y-1 text-sm text-muted" data-pagefind-ignore>
            {v.upload_date && <span>{date(v.upload_date)}</span>}
            {v.duration && <span>· {duration(v.duration)}</span>}
            {v.view_count && <span>· {compact(v.view_count)} views</span>}
            {v.format && <span class="capitalize">· {v.format}</span>}
            <span>· <a class="underline hover:text-accent" href={`https://www.youtube.com/watch?v=${v.id}`} rel="noopener">Watch on YouTube</a></span>
          </p>
          <meta data-pagefind-meta={`image:${thumb(v.id)}`} />
          {categoryNames.map((c) => <meta data-pagefind-filter={`topic:${c}`} />)}
          <meta data-pagefind-filter={`content:${v.segments.length ? "Full transcript" : "Summary only"}`} />
        </header>

        <TopicChips topics={v.topics} />

        {v.summary && (
          <section aria-labelledby="summary-h" class="rounded-xl border border-line bg-surface p-5">
            <h2 id="summary-h" class="font-serif text-xl font-semibold mb-2">Summary</h2>
            <p class="leading-relaxed">{v.summary}</p>
            {v.key_points.length > 0 && (
              <>
                <h3 class="font-semibold mt-4 mb-2">Key points</h3>
                <ul class="list-disc pl-5 space-y-1.5 marker:text-accent">
                  {v.key_points.map((k) => <li class="leading-relaxed">{k}</li>)}
                </ul>
              </>
            )}
          </section>
        )}

        {v.chapters.length > 0 && (
          <section aria-labelledby="chapters-h" class="rounded-xl border border-line bg-surface p-5">
            <h2 id="chapters-h" class="font-serif text-xl font-semibold mb-2">Chapters</h2>
            <ol class="space-y-1">
              {v.chapters.map((c) => (
                <li><a href={`#t-${Math.floor(c.start)}`} data-seek={c.start} class="hover:text-accent"><span class="font-mono text-xs text-muted mr-2">{timestamp(c.start)}</span><span lang="ar">{c.title}</span></a></li>
              ))}
            </ol>
          </section>
        )}

        {v.segments.length > 0 ? (
          <Transcript segments={v.segments} title={t.text} notices={v.notices} />
        ) : (
          <section class="rounded-xl border border-dashed border-line bg-surface p-6 text-center" data-pagefind-ignore>
            <h2 class="font-serif text-xl font-semibold">Transcript in progress</h2>
            <p class="mt-2 text-muted max-w-prose mx-auto">
              The full English transcript of this video hasn't been produced yet. The title and summary above come from the
              video's Arabic title and description. Transcripts are being added continuously.
            </p>
          </section>
        )}

        {(v.description_en || v.description_ar) && (
          <details class="rounded-xl border border-line bg-surface p-5" data-pagefind-ignore>
            <summary class="cursor-pointer font-semibold">Original video description</summary>
            {v.description_en && <p class="mt-3 whitespace-pre-line leading-relaxed">{v.description_en}</p>}
            {v.description_ar && <p lang="ar" dir="rtl" class="mt-3 whitespace-pre-line text-muted">{v.description_ar}</p>}
          </details>
        )}
      </div>

      <aside class="space-y-6 lg:sticky lg:top-20 lg:self-start" data-pagefind-ignore>
        {primary && (prev || next) && (
          <nav aria-label="Series navigation" class="rounded-xl border border-line bg-surface p-4 space-y-3">
            <p class="text-xs font-semibold uppercase tracking-wide text-muted">In this series</p>
            {prev && <a class="block hover:text-accent" href={href(`/v/${prev.id}/`)}><span class="text-xs text-muted">← Previous</span><br /><span class="font-medium line-clamp-2" {...langAttrs(title(prev).ar)}>{title(prev).text}</span></a>}
            {next && <a class="block hover:text-accent" href={href(`/v/${next.id}/`)}><span class="text-xs text-muted">Next →</span><br /><span class="font-medium line-clamp-2" {...langAttrs(title(next).ar)}>{title(next).text}</span></a>}
            <a class="block text-sm text-accent hover:underline" href={href(`/series/${primary.slug}/`)}>All {primary.video_ids.length} episodes</a>
          </nav>
        )}
        {hasRefs && (
          <section aria-labelledby="refs-h" class="rounded-xl border border-line bg-surface p-4 space-y-4 text-sm">
            <h2 id="refs-h" class="font-serif text-lg font-semibold">References</h2>
            {refs.quran.length > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-muted mb-1.5">Qur'an</h3>
                <ul class="space-y-1">
                  {refs.quran.map((q) => (
                    <li><a class="text-accent hover:underline" href={quranUrl(q.surah, q.ayah_start, q.ayah_end)} rel="noopener">{quranLabel(q.surah, q.ayah_start, q.ayah_end)}</a>{q.note && <span class="text-muted"> — {q.note}</span>}</li>
                  ))}
                </ul>
              </div>
            )}
            {refs.people.length > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-muted mb-1.5">People</h3>
                <p>{refs.people.join(" · ")}</p>
              </div>
            )}
            {refs.works.length > 0 && (
              <div>
                <h3 class="text-xs font-semibold uppercase tracking-wide text-muted mb-1.5">Works</h3>
                <ul class="space-y-1 italic">{refs.works.map((w) => <li>{w}</li>)}</ul>
              </div>
            )}
          </section>
        )}
        {playlists.length > 1 && (
          <section class="rounded-xl border border-line bg-surface p-4 text-sm">
            <h2 class="text-xs font-semibold uppercase tracking-wide text-muted mb-2">Also in playlists</h2>
            <ul class="space-y-1">{playlists.slice(1).map((p) => <li><a class="hover:text-accent" href={href(`/series/${p.slug}/`)}><span {...langAttrs(title(p).ar)}>{title(p).text}</span></a></li>)}</ul>
          </section>
        )}
        <p class="text-xs text-muted leading-relaxed">
          {v.segments.length ? `Transcript machine-translated from the Arabic audio (${v.transcript_model}).` : "Catalog entry generated from the Arabic title and description."}
          {" "}It may contain errors; consult the original for anything important.
        </p>
      </aside>
    </div>
  </article>
</Base>
