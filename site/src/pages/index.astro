---
import Base from "~/layouts/Base.astro";
import VideoGrid from "~/components/VideoGrid.astro";
import { getCategories, getPlaylists, getStats, getVideos } from "~/lib/data";
import { href, langAttrs, thumb, title } from "~/lib/format";

const stats = getStats();
const videos = getVideos();
const categories = getCategories().filter((c) => c.count > 0).sort((a, b) => b.count - a.count);
const playlists = getPlaylists().filter((p) => p.video_ids.length > 0).sort((a, b) => b.video_ids.length - a.video_ids.length);
const transcribed = videos.filter((v) => v.has_transcript).slice(0, 8);
const latest = videos.slice(0, 8);
---
<Base title="Al-Haydari Lecture Catalog">
  <section class="border-b border-line bg-gradient-to-b from-surface-2/80 to-bg">
    <div class="mx-auto max-w-6xl px-4 py-14 sm:py-20">
      <p class="text-xs font-semibold uppercase tracking-[0.18em] text-gold">Lectures of Sayyid Kamal al-Haydari · in English</p>
      <h1 class="mt-3 font-serif text-4xl sm:text-5xl font-semibold leading-tight max-w-3xl text-balance">
        {stats.hours.toLocaleString("en")} hours of Arabic lectures on philosophy, theology, jurisprudence and the Qur'an, catalogued in English
      </h1>
      <p class="mt-4 max-w-2xl text-lg text-muted">
        Browse by topic or series, read English summaries, and follow along with full timestamped translations of the original Arabic.
      </p>
      <form action={href("/search/")} method="get" role="search" class="mt-8 flex max-w-xl gap-2">
        <label for="q" class="sr-only">Search lectures and transcripts</label>
        <input id="q" name="q" type="search" placeholder="Search e.g. “primacy of existence”, “wilayat al-faqih”…" class="flex-1 rounded-lg border border-line bg-surface px-4 py-3 shadow-sm outline-none focus:border-accent" />
        <button class="rounded-lg bg-accent px-5 py-3 font-medium text-accent-ink hover:opacity-90">Search</button>
      </form>
      <dl class="mt-10 grid grid-cols-2 sm:grid-cols-4 gap-4 max-w-3xl">
        {[
          [stats.videos.toLocaleString("en"), "videos"],
          [stats.playlists, "series"],
          [stats.transcribed.toLocaleString("en"), "full transcripts"],
          [`${stats.transcribed_hours.toLocaleString("en")} h`, "translated audio"],
        ].map(([n, l]) => (
          <div class="rounded-xl border border-line bg-surface px-4 py-3">
            <dt class="text-xs text-muted">{l}</dt>
            <dd class="font-serif text-2xl font-semibold">{n}</dd>
          </div>
        ))}
      </dl>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-4 space-y-16 mt-12">
    {categories.length > 0 && (
      <section aria-labelledby="topics-h">
        <div class="flex items-baseline justify-between mb-5">
          <h2 id="topics-h" class="font-serif text-2xl font-semibold">Browse by topic</h2>
          <a href={href("/topics/")} class="text-sm text-accent hover:underline">All topics →</a>
        </div>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {categories.slice(0, 12).map((c) => (
            <a href={href(`/topics/${c.slug}/`)} class="group rounded-xl border border-line bg-surface p-4 hover:border-accent/60">
              <p class="flex items-baseline justify-between gap-2">
                <span class="font-serif text-lg font-semibold group-hover:text-accent">{c.name}</span>
                <span class="text-xs text-muted shrink-0">{c.count} videos</span>
              </p>
              <p class="mt-1 text-sm text-muted line-clamp-2">{c.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section aria-labelledby="series-h">
      <div class="flex items-baseline justify-between mb-5">
        <h2 id="series-h" class="font-serif text-2xl font-semibold">Lecture series</h2>
        <a href={href("/series/")} class="text-sm text-accent hover:underline">All {playlists.length} series&nbsp;→</a>
      </div>
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {playlists.slice(0, 8).map((p) => (
          <a href={href(`/series/${p.slug}/`)} class="group rounded-xl border border-line bg-surface overflow-hidden hover:border-accent/60">
            <div class="relative aspect-video bg-surface-2">
              <img src={thumb(p.video_ids[0])} alt="" loading="lazy" class="size-full object-cover" width="320" height="180" />
              <span class="absolute bottom-1.5 right-1.5 rounded bg-black/75 px-1.5 py-0.5 text-[11px] font-medium text-white">{p.video_ids.length} episodes</span>
            </div>
            <div class="p-3.5">
              <p class="font-serif font-semibold leading-snug group-hover:text-accent line-clamp-2" {...langAttrs(title(p).ar)}>{title(p).text}</p>
              {p.title_en && <p lang="ar" dir="rtl" class="text-sm text-muted line-clamp-1">{p.title_ar}</p>}
            </div>
          </a>
        ))}
      </div>
    </section>

    {transcribed.length > 0 && (
      <section aria-labelledby="tr-h">
        <div class="flex items-baseline justify-between mb-5">
          <h2 id="tr-h" class="font-serif text-2xl font-semibold">With full English transcripts</h2>
          <a href={href("/videos/?transcript=1")} class="text-sm text-accent hover:underline">All transcribed →</a>
        </div>
        <VideoGrid videos={transcribed} showSummary />
      </section>
    )}

    <section aria-labelledby="latest-h">
      <div class="flex items-baseline justify-between mb-5">
        <h2 id="latest-h" class="font-serif text-2xl font-semibold">Latest uploads</h2>
        <a href={href("/videos/")} class="text-sm text-accent hover:underline">All videos →</a>
      </div>
      <VideoGrid videos={latest} />
    </section>
  </div>
</Base>
