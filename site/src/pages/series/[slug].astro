---
import Base from "~/layouts/Base.astro";
import PageHeader from "~/components/PageHeader.astro";
import VideoList from "~/components/VideoList.astro";
import { getPlaylists, playlistVideos } from "~/lib/data";
import { duration, href, title } from "~/lib/format";

export function getStaticPaths() {
  return getPlaylists().map((p) => ({ params: { slug: p.slug }, props: { playlist: p } }));
}
const { playlist: p } = Astro.props;
const videos = playlistVideos(p);
const total = videos.reduce((n, v) => n + (v.duration ?? 0), 0);
const transcribed = videos.filter((v) => v.has_transcript).length;
const t = title(p);
---
<Base title={t.text} description={p.description_en || `${videos.length}-episode lecture series by Sayyid Kamal al-Haydari: ${t.text}.`}>
  <PageHeader title={t.text} titleAr={t.ar} arabic={t.ar ? undefined : p.title_ar} eyebrow="Series" crumbs={[{ label: "Series", href: href("/series/") }]}>
    {p.description_en && <p class="mt-3 max-w-2xl text-muted whitespace-pre-line">{p.description_en}</p>}
    <p class="mt-3 text-sm text-muted">
      {videos.length} episodes · {duration(total)}{transcribed > 0 && ` · ${transcribed} with full transcripts`} ·
      <a class="underline hover:text-accent" href={`https://www.youtube.com/playlist?list=${p.id}`} rel="noopener">YouTube playlist</a>
    </p>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 mt-8">
    <VideoList videos={videos} numbered />
  </div>
</Base>
