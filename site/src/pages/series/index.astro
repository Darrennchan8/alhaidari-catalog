---
import Base from "~/layouts/Base.astro";
import PageHeader from "~/components/PageHeader.astro";
import { getPlaylists, playlistVideos } from "~/lib/data";
import { href, langAttrs, thumb, title } from "~/lib/format";

const playlists = getPlaylists()
  .filter((p) => p.video_ids.length > 0)
  .map((p) => {
    const vids = playlistVideos(p);
    return { p, vids, transcribed: vids.filter((v) => v.has_transcript).length, hours: Math.round(vids.reduce((n, v) => n + (v.duration ?? 0), 0) / 3600) };
  })
  .sort((a, b) => b.vids.length - a.vids.length);
---
<Base title="Lecture series" description="All lecture series and playlists from the al-Haydari channel, with English titles.">
  <PageHeader title="Lecture series" eyebrow="Playlists">
    <p class="mt-3 max-w-2xl text-muted">Courses and programs as organised on the original channel, from multi-year seminary courses to short TV series.</p>
  </PageHeader>
  <div class="mx-auto max-w-6xl px-4 mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {playlists.map(({ p, vids, transcribed, hours }) => (
      <a href={href(`/series/${p.slug}/`)} class="group flex gap-4 rounded-xl border border-line bg-surface p-3 hover:border-accent/60">
        <img src={thumb(p.video_ids[0])} alt="" loading="lazy" class="w-28 aspect-video shrink-0 rounded-lg object-cover bg-surface-2" width="160" height="90" />
        <div class="min-w-0">
          <p class="font-serif font-semibold leading-snug group-hover:text-accent line-clamp-2" {...langAttrs(title(p).ar)}>{title(p).text}</p>
          {p.title_en && <p lang="ar" dir="rtl" class="text-sm text-muted line-clamp-1">{p.title_ar}</p>}
          <p class="mt-1 text-xs text-muted">{vids.length} episodes · {hours} h{transcribed > 0 && ` · ${transcribed} transcribed`}</p>
        </div>
      </a>
    ))}
  </div>
</Base>
