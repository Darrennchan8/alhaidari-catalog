---
import Base from "~/layouts/Base.astro";
import { href } from "~/lib/format";
---
<Base title="Page not found" noindex>
  <div class="mx-auto max-w-xl px-4 py-24 text-center">
    <p class="font-serif text-6xl font-semibold text-accent">404</p>
    <h1 class="mt-4 font-serif text-2xl font-semibold">This page doesn't exist</h1>
    <p class="mt-2 text-muted">It may have moved, or the video may have been removed from the channel.</p>
    <p class="mt-6 flex justify-center gap-4"><a class="text-accent underline" href={href("/")}>Home</a><a class="text-accent underline" href={href("/search/")}>Search</a><a class="text-accent underline" href={href("/videos/")}>All videos</a></p>
  </div>
</Base>
