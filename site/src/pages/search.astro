---
import Base from "~/layouts/Base.astro";
import PageHeader from "~/components/PageHeader.astro";
import { href } from "~/lib/format";
---
<Base title="Search" description="Full-text search across English titles, summaries and transcripts." noindex>
  <link rel="stylesheet" href={href("/pagefind/pagefind-ui.css")} />
  <PageHeader title="Search" eyebrow="Titles, summaries and full transcripts">
    <p class="mt-3 max-w-2xl text-muted">Search runs entirely in your browser. Try a concept (“primacy of existence”), a name (“Ibn Taymiyya”) or a transliterated term (“taqlid”).</p>
  </PageHeader>
  <div class="mx-auto max-w-4xl px-4 mt-8">
    <div id="search" data-bundle={href("/pagefind/")}></div>
    <noscript><p class="text-muted">Search requires JavaScript. Browse <a class="underline" href={href("/topics/")}>by topic</a> instead.</p></noscript>
  </div>
</Base>
<script>
  const el = document.getElementById("search")!;
  const bundle = el.dataset.bundle!;
  const s = document.createElement("script");
  s.src = `${bundle}pagefind-ui.js`;
  s.onload = () => {
    // @ts-expect-error provided by pagefind-ui.js
    const ui = new PagefindUI({
      element: "#search",
      bundlePath: bundle,
      showImages: true,
      showSubResults: true,
      excerptLength: 30,
      resetStyles: false,
      autofocus: true,
      translations: { placeholder: "Search lectures and transcripts" },
    });
    const q = new URLSearchParams(location.search).get("q");
    if (q) ui.triggerSearch(q);
  };
  s.onerror = () => {
    el.innerHTML = `<p class="rounded-xl border border-dashed border-line p-8 text-center text-muted">The search index isn't available in development. Run <code>npm run build &amp;&amp; npm run preview</code>.</p>`;
  };
  document.head.append(s);
</script>
