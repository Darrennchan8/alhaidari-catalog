---
import { thumb } from "~/lib/format";

interface Props {
  id: string;
  title: string;
}
const { id, title } = Astro.props;
---
<div class="relative aspect-video overflow-hidden rounded-xl bg-black shadow-sm" id="player-wrap" data-video-id={id}>
  <button id="player-poster" class="group absolute inset-0 size-full" aria-label={`Play video: ${title}`}>
    <img src={thumb(id, "hq")} alt="" class="size-full object-cover opacity-90 group-hover:opacity-100" width="480" height="360" />
    <span class="absolute inset-0 grid place-items-center">
      <span class="grid size-16 place-items-center rounded-full bg-black/70 group-hover:bg-accent transition">
        <svg viewBox="0 0 24 24" class="ml-1 size-8 fill-white" aria-hidden="true"><path d="M8 5v14l11-7z" /></svg>
      </span>
    </span>
  </button>
  <div id="player" class="absolute inset-0"></div>
</div>
<script>
  // Lazily loads the YouTube IFrame API, then wires transcript timestamps to the player.
  type YTPlayer = { seekTo(s: number, allow: boolean): void; playVideo(): void; getCurrentTime(): number; getPlayerState(): number };
  declare global {
    interface Window { YT?: any; onYouTubeIframeAPIReady?: () => void }
  }

  const wrap = document.getElementById("player-wrap")!;
  const videoId = wrap.dataset.videoId!;
  let player: YTPlayer | null = null;
  let ready: Promise<YTPlayer> | null = null;

  function loadPlayer(start = 0): Promise<YTPlayer> {
    ready ??= new Promise((resolve) => {
      const create = () => {
        document.getElementById("player-poster")?.remove();
        const p = new window.YT.Player("player", {
          videoId,
          width: "100%",
          height: "100%",
          playerVars: { autoplay: 1, start: Math.floor(start), rel: 0, modestbranding: 1, playsinline: 1 },
          events: { onReady: () => { player = p; resolve(p); } },
        });
      };
      if (window.YT?.Player) return create();
      window.onYouTubeIframeAPIReady = create;
      const s = document.createElement("script");
      s.src = "https://www.youtube.com/iframe_api";
      document.head.append(s);
    });
    return ready;
  }

  async function seek(seconds: number) {
    if (!player) {
      await loadPlayer(seconds);
      return;
    }
    player.seekTo(seconds, true);
    player.playVideo();
  }

  document.getElementById("player-poster")?.addEventListener("click", () => loadPlayer(startFromHash()));

  document.addEventListener("click", (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>("[data-seek]");
    if (!el) return;
    e.preventDefault();
    const t = Number(el.dataset.seek);
    history.replaceState(null, "", `#t-${Math.floor(t)}`);
    wrap.scrollIntoView({ behavior: "smooth", block: "nearest" });
    void seek(t);
  });

  function startFromHash(): number {
    const m = location.hash.match(/^#t-?=?(\d+)/);
    return m ? Number(m[1]) : 0;
  }

  // Highlight (and optionally follow) the segment being played.
  const segs = [...document.querySelectorAll<HTMLElement>(".seg")];
  const follow = document.getElementById("follow") as HTMLInputElement | null;
  let current: HTMLElement | undefined;
  setInterval(() => {
    if (!player || player.getPlayerState() !== 1) return;
    const t = player.getCurrentTime();
    let lo = 0, hi = segs.length - 1, idx = -1;
    while (lo <= hi) {
      const mid = (lo + hi) >> 1;
      if (Number(segs[mid].dataset.start) <= t) { idx = mid; lo = mid + 1; } else hi = mid - 1;
    }
    const seg = segs[idx];
    if (!seg || seg === current) return;
    current?.removeAttribute("aria-current");
    seg.setAttribute("aria-current", "true");
    current = seg;
    if (follow?.checked) seg.scrollIntoView({ behavior: "smooth", block: "center" });
  }, 500);

  // Deep link: highlight the linked segment on load.
  const linked = startFromHash();
  if (linked) {
    const seg = segs.find((s) => Math.floor(Number(s.dataset.start)) === linked);
    seg?.setAttribute("aria-current", "true");
    current = seg;
    seg?.scrollIntoView({ block: "center" });
  }
</script>
