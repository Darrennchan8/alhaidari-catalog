---
import type { VideoSummary } from "~/lib/types";
import VideoCard from "./VideoCard.astro";

interface Props {
  videos: VideoSummary[];
  numbered?: boolean;
  showSummary?: boolean;
}
const { videos, numbered = false, showSummary = false } = Astro.props;
---
<div class="grid gap-4 grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  {videos.map((v, i) => <VideoCard video={v} index={numbered ? i + 1 : undefined} showSummary={showSummary} />)}
</div>
