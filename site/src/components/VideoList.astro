---
import type { VideoSummary } from "~/lib/types";
import { date, duration, href, langAttrs, thumb, title } from "~/lib/format";

interface Props {
  videos: VideoSummary[];
  numbered?: boolean;
}
const { videos, numbered = false } = Astro.props;
---
<ol class="divide-y divide-line rounded-xl border border-line bg-surface">
  {videos.map((v, i) => (
    <li class="group relative flex gap-4 p-3 sm:p-4 hover:bg-surface-2/60">
      {numbered && <span class="hidden sm:block w-8 shrink-0 pt-1 text-right font-mono text-sm text-muted">{i + 1}</span>}
      <div class="relative w-28 sm:w-40 shrink-0 aspect-video overflow-hidden rounded-lg bg-surface-2">
        <img src={thumb(v.id)} alt="" loading="lazy" decoding="async" class="size-full object-cover" width="160" height="90" />
        {v.duration && <span class="absolute bottom-1 right-1 rounded bg-black/75 px-1 text-[10px] font-medium text-white">{duration(v.duration)}</span>}
      </div>
      <div class="min-w-0 flex-1">
        <h3 class="font-serif font-semibold leading-snug">
          <a href={href(`/v/${v.id}/`)} class="after:absolute after:inset-0 group-hover:text-accent" {...langAttrs(title(v).ar)}>{title(v).text}</a>
        </h3>
        {v.title_en && <p lang="ar" dir="rtl" class="text-sm text-muted line-clamp-1">{v.title_ar}</p>}
        {v.summary && <p class="mt-1 hidden sm:block text-sm text-muted line-clamp-2">{v.summary}</p>}
        <p class="mt-1 flex flex-wrap items-center gap-x-2 text-xs text-muted">
          {v.upload_date && <span>{date(v.upload_date)}</span>}
          {v.has_transcript && <span class="rounded bg-accent-soft px-1.5 font-semibold text-accent">Transcript</span>}
        </p>
      </div>
    </li>
  ))}
</ol>
