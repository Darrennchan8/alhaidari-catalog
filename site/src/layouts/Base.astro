---
import "~/styles/global.css";
import { href } from "~/lib/format";

interface Props {
  title: string;
  description?: string;
  image?: string;
  jsonLd?: object;
  noindex?: boolean;
}
const { title, description = "An English-language catalog of the lectures of Sayyid Kamal al-Haydari: translated titles, summaries, topics and full timestamped transcripts.", image, jsonLd, noindex } = Astro.props;
const siteName = "Al-Haydari Lecture Catalog";
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [
  { path: "/topics/", label: "Topics" },
  { path: "/series/", label: "Series" },
  { path: "/videos/", label: "All videos" },
  { path: "/about/", label: "About" },
];
const current = Astro.url.pathname;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={image ? "video.other" : "website"} />
    {image && <meta property="og:image" content={image} />}
    <meta name="twitter:card" content={image ? "summary_large_image" : "summary"} />
    <link rel="icon" href={href("/favicon.svg")} type="image/svg+xml" />
    <link rel="sitemap" href={href("/sitemap-index.xml")} />
    <meta name="theme-color" content="#f8f5ef" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#12110f" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Noto+Naskh+Arabic:wght@400;600&family=Source+Serif+4:opsz,wght@8..60,500;8..60,600;8..60,700&display=swap"
    />
    <script is:inline>
      (() => {
        let t = null;
        try { t = localStorage.getItem("theme"); } catch {}
        if (!t) t = matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        document.documentElement.dataset.theme = t;
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body class="min-h-screen flex flex-col">
    <a href="#main" class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 bg-surface px-3 py-2 rounded">Skip to content</a>
    <header class="border-b border-line bg-bg/85 backdrop-blur sticky top-0 z-40">
      <div class="mx-auto max-w-6xl px-4 h-14 flex items-center gap-4">
        <a href={href("/")} class="flex items-center gap-2 font-serif font-semibold text-lg shrink-0" aria-label={`${siteName} home`}>
          <svg viewBox="0 0 32 32" class="size-7" aria-hidden="true"><rect width="32" height="32" rx="8" class="fill-accent"/><path d="M16 10.5c-2.2-1.6-5-2.1-8-1.8v12.6c3-.3 5.8.2 8 1.8 2.2-1.6 5-2.1 8-1.8V8.7c-3-.3-5.8.2-8 1.8zm0 0v12.6" fill="none" stroke-width="1.8" stroke-linejoin="round" class="stroke-accent-ink"/></svg>
          <span class="hidden sm:inline">Al-Haydari <span class="text-muted font-normal">Catalog</span></span>
        </a>
        <nav aria-label="Main" class="flex-1 overflow-x-auto">
          <ul class="flex gap-1 text-sm">
            {nav.map((n) => (
              <li>
                <a
                  href={href(n.path)}
                  class:list={["px-2.5 py-1.5 rounded-md whitespace-nowrap hover:bg-surface-2", current.startsWith(href(n.path)) && "text-accent font-medium"]}
                  aria-current={current.startsWith(href(n.path)) ? "page" : undefined}
                >{n.label}</a>
              </li>
            ))}
          </ul>
        </nav>
        <a href={href("/search/")} class="p-2 rounded-md hover:bg-surface-2" aria-label="Search">
          <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/></svg>
        </a>
        <button id="theme-toggle" class="p-2 rounded-md hover:bg-surface-2" aria-label="Toggle dark mode">
          <svg viewBox="0 0 24 24" class="size-5 dark:hidden" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"/></svg>
          <svg viewBox="0 0 24 24" class="size-5 hidden dark:block" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
        </button>
      </div>
    </header>
    <main id="main" class="flex-1">
      <slot />
    </main>
    <footer class="border-t border-line mt-16">
      <div class="mx-auto max-w-6xl px-4 py-8 text-sm text-muted grid gap-3 sm:flex sm:justify-between">
        <p>
          An independent English catalog of the
          <a class="underline hover:text-accent" href="https://www.youtube.com/@alheydari" rel="noopener">al-Haydari YouTube channel</a>.
          Translations are machine-generated and may contain errors; the Arabic original is authoritative.
        </p>
        <p class="shrink-0"><a class="underline hover:text-accent" href={href("/about/")}>About &amp; method</a></p>
      </div>
    </footer>
    <script>
      document.getElementById("theme-toggle")?.addEventListener("click", () => {
        const next = document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = next;
        try { localStorage.setItem("theme", next); } catch {}
      });
    </script>
  </body>
</html>
